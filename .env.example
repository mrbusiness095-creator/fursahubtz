# ZonmPay secret key - SERVER ONLY. Never use VITE_ prefix.
ZONMPAY_API_KEY=

# ZonmPay webhook signing secret - SERVER ONLY.
ZONMPAY_WEBHOOK_SECRET=

# Netlify Database is injected automatically by @netlify/database.
# Do not paste the production database URL into source control.
# NETLIFY_DB_URL is managed by Netlify.

# Admin panel password - SERVER ONLY.
ADMIN_PASSWORD=
